def oblicz_indeks_hirscha(identyfikatory, cytowania):

    artykuly = list(zip(identyfikatory, cytowania))
    artykuly_posortowane = sorted(artykuly, key=lambda x: x[1], reverse=True)
    
    h_index = 0
    id_artykulow_h = []
    
    for i, (art_id, cytowania_count) in enumerate(artykuly_posortowane):
        pozycja = i + 1  
        
        if cytowania_count >= pozycja:
            h_index = pozycja
            id_artykulow_h.append(art_id)
        else:
            break
            
    return h_index, id_artykulow_h

if __name__ == "__main__":
    print("--- Test 1  ---")
    id_1 = ["Id1", "Id2", "Id3"]
    cytowania_1 = [1, 3, 2]
    
    h1, artykuly_1 = oblicz_indeks_hirscha(id_1, cytowania_1)
    print(
        f"WE: {id_1}, {cytowania_1}\n"
        f"WY: H = {h1}\n"
        f"Artykuły tworzące indeks H: {artykuly_1}"
    )
    
    print("\n--- Test 2 (Większy zbiór danych) ---")
    id_2 = ["ArtA", "ArtB", "ArtC", "ArtD", "ArtE", "ArtF"]
    cytowania_2 = [10, 8, 5, 4, 3, 0]
    h2, artykuly_2 = oblicz_indeks_hirscha(id_2, cytowania_2)
    
    print(
        f"WE: {id_2}, {cytowania_2}\n"
        f"WY: H = {h2}\n"
        f"Artykuły tworzące indeks H: {artykuly_2}"
    )